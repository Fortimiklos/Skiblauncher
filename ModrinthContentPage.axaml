            <Button Content="Vissza" Click="Button_OnClick"></Button>
    </ContentPage.TopCommandBar>
    <NativeWebView
        x:Name="Modrinth"
        Source="https://modrinth.com/discover/mods">
        </NativeWebView>
</ContentPage>