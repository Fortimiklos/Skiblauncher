<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Skiblauncher.CurseForgeContentPage"
             x:Name="root">
    <ContentPage.TopCommandBar>
        <Button Content="Vissza" Click="Button_OnClick"></Button>
    </ContentPage.TopCommandBar>
    <NativeWebView
        x:Name="CurseForge"
        Source="https://www.curseforge.com/minecraft"></NativeWebView>
</ContentPage>